<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="net.paramada.pokemada.controller.MainController">
    <fx:define>
        <ToggleGroup fx:id="navigationGroup"/>
    </fx:define>

    <left>
        <VBox fx:id="sidebar" prefWidth="264.0" styleClass="sidebar">
            <children>
                <StackPane minHeight="116.0" prefHeight="116.0" styleClass="brand-area">
                    <ImageView fx:id="sidebarWordmark" fitHeight="82.0" fitWidth="226.0" preserveRatio="true" smooth="true"
                               styleClass="master-v-nav-wordmark">
                        <image><Image url="@assets/master-v-wordmark.png"/></image>
                    </ImageView>
                    <ImageView fx:id="sidebarAppIcon" fitHeight="56.0" fitWidth="56.0" managed="false"
                               preserveRatio="true" smooth="true" visible="false" styleClass="master-v-nav-emblem">
                        <image><Image url="@assets/master-v-emblem.png"/></image>
                    </ImageView>
                    <Button fx:id="sidebarCollapseButton" mnemonicParsing="false" onAction="#toggleSidebar"
                            StackPane.alignment="TOP_RIGHT" text="‹" styleClass="sidebar-collapse-button"/>
                </StackPane>
                <Separator styleClass="sidebar-separator"/>

                <VBox fx:id="navigation" spacing="4.0" styleClass="navigation">
                    <padding><Insets bottom="8.0" left="12.0" right="0.0" top="8.0"/></padding>
                    <ToggleButton fx:id="homeNavigationButton" mnemonicParsing="false" onAction="#selectSection"
                                  selected="true" text="INICIO" userData="home"
                                  toggleGroup="$navigationGroup" styleClass="nav-item">
                        <graphic><Label text="⌂" styleClass="nav-icon"/></graphic>
                    </ToggleButton>
                    <ToggleButton mnemonicParsing="false" onAction="#selectSection" text="COMBATES" userData="live"
                                  toggleGroup="$navigationGroup" styleClass="nav-item">
                        <graphic><Label text="⚔" styleClass="nav-icon"/></graphic>
                    </ToggleButton>
                    <ToggleButton mnemonicParsing="false" onAction="#selectSection" text="CAJAS" userData="boxes"
                                  toggleGroup="$navigationGroup" styleClass="nav-item">
                        <graphic><Label text="▣" styleClass="nav-icon"/></graphic>
                    </ToggleButton>
                    <ToggleButton mnemonicParsing="false" onAction="#selectSection" text="COMODINES" userData="wildcards"
                                  toggleGroup="$navigationGroup" styleClass="nav-item">
                        <graphic><Label text="✦" styleClass="nav-icon"/></graphic>
                    </ToggleButton>
                    <ToggleButton mnemonicParsing="false" onAction="#selectSection" text="MOCHILA" userData="inventory"
                                  toggleGroup="$navigationGroup" styleClass="nav-item">
                        <graphic><Label text="▰" styleClass="nav-icon"/></graphic>
                    </ToggleButton>
                    <ToggleButton mnemonicParsing="false" onAction="#selectSection" text="BUZÓN" userData="mailbox"
                                  toggleGroup="$navigationGroup" styleClass="nav-item">
                        <graphic><Label text="✉" styleClass="nav-icon"/></graphic>
                    </ToggleButton>
                    <ToggleButton mnemonicParsing="false" onAction="#selectSection" text="SOBRES" userData="booster-packs"
                                  toggleGroup="$navigationGroup" styleClass="nav-item">
                        <graphic><Label text="▱" styleClass="nav-icon"/></graphic>
                    </ToggleButton>
                    <ToggleButton mnemonicParsing="false" onAction="#selectSection" text="PERFIL" userData="profile"
                                  toggleGroup="$navigationGroup" styleClass="nav-item">
                        <graphic><Label text="●" styleClass="nav-icon"/></graphic>
                    </ToggleButton>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>
                <VBox fx:id="sidebarFooter" spacing="8.0" styleClass="sidebar-footer">
                    <padding><Insets bottom="14.0" left="16.0" right="14.0" top="10.0"/></padding>
                    <Separator styleClass="sidebar-separator"/>
                    <HBox fx:id="emulatorConnectionRow" alignment="CENTER_LEFT" spacing="12.0" styleClass="connection-row">
                        <ImageView fx:id="emulatorConnectionIcon" fitHeight="44.0" fitWidth="44.0"
                                   preserveRatio="true" smooth="false">
                            <image><Image url="@assets/madalime_off.png"/></image>
                        </ImageView>
                        <VBox fx:id="emulatorConnectionDetails" HBox.hgrow="ALWAYS">
                            <Label text="LimoMada3DS" styleClass="footer-title"/>
                            <Label fx:id="emulatorConnectionStatus" text="Desconectado" styleClass="footer-subtitle"/>
                        </VBox>
                        <Button fx:id="emulatorRetryButton" mnemonicParsing="false" text="↻" onAction="#refreshLiveData" styleClass="retry-button"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="profile-row">
                        <ImageView fx:id="profilePicture" fitHeight="42.0" fitWidth="42.0" preserveRatio="true" styleClass="profile-picture">
                            <image><Image url="@assets/profile.png"/></image>
                        </ImageView>
                        <VBox fx:id="trainerDetails" HBox.hgrow="ALWAYS">
                            <Label fx:id="profileTrainerName" text="Entrenador" styleClass="profile-name"/>
                            <Label text="Pokémon Luna" styleClass="footer-subtitle"/>
                        </VBox>
                        <Button fx:id="logoutButton" mnemonicParsing="false" text="SALIR" onAction="#logout"
                                styleClass="sidebar-logout-button"/>
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="main-background">
            <ScrollPane fx:id="homeView" fitToWidth="true" hbarPolicy="NEVER" managed="false"
                        visible="false" styleClass="content-scroll">
                <content>
                    <VBox spacing="24.0" styleClass="content">
                        <padding><Insets bottom="44.0" left="44.0" right="44.0" top="34.0"/></padding>
                        <FlowPane hgap="24.0" vgap="24.0" prefWrapLength="880.0">
                            <VBox prefHeight="300.0" prefWidth="440.0" styleClass="dashboard-card">
                                <StackPane styleClass="card-header">
                                    <Label text="Noticias" styleClass="card-title"/>
                                    <ImageView fitHeight="105.0" fitWidth="105.0" preserveRatio="true"
                                               StackPane.alignment="CENTER_RIGHT" translateX="38.0" translateY="42.0">
                                        <image><Image url="@assets/pokeball.png"/></image>
                                    </ImageView>
                                </StackPane>
                                <VBox spacing="14.0" styleClass="card-body" VBox.vgrow="ALWAYS">
                                    <Label text="¡Bienvenido a Master V!" styleClass="news-heading"/>
                                    <Label text="La nueva aplicación Java está lista para comenzar la integración con el emulador."
                                           wrapText="true" styleClass="body-text"/>
                                    <Separator/>
                                    <Label text="El contenido dinámico se conectará en los siguientes incrementos."
                                           wrapText="true" styleClass="body-muted"/>
                                </VBox>
                            </VBox>

                            <VBox prefHeight="300.0" prefWidth="440.0" styleClass="dashboard-card">
                                <StackPane styleClass="card-header">
                                    <Label text="Notificaciones" styleClass="card-title"/>
                                    <Button text="Reconectar"
                                            onAction="#reconnectNotifications"
                                            styleClass="notification-reconnect-button"
                                            StackPane.alignment="CENTER_RIGHT"/>
                                </StackPane>
                                <StackPane styleClass="empty-card-body" VBox.vgrow="ALWAYS">
                                    <VBox fx:id="notificationEmptyState" alignment="CENTER" spacing="10.0">
                                        <Label text="✓" styleClass="empty-icon"/>
                                        <Label text="Aún no hay notificaciones" styleClass="body-muted"/>
                                    </VBox>
                                    <ScrollPane fx:id="notificationScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="notification-scroll">
                                        <content>
                                            <VBox fx:id="notificationEntries" spacing="10.0"/>
                                        </content>
                                    </ScrollPane>
                                </StackPane>
                            </VBox>

                            <VBox prefHeight="220.0" prefWidth="440.0" styleClass="dashboard-card">
                                <StackPane styleClass="card-header">
                                    <Label text="Estado del juego" styleClass="card-title"/>
                                </StackPane>
                                <VBox spacing="12.0" styleClass="card-body" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label text="●" styleClass="status-offline"/>
                                        <Label text="Esperando conexión con el emulador" styleClass="body-text"/>
                                    </HBox>
                                    <Label text="Puerto UDP predeterminado: 45987" styleClass="body-muted"/>
                                </VBox>
                            </VBox>

                            <VBox prefHeight="220.0" prefWidth="440.0" styleClass="dashboard-card">
                                <StackPane styleClass="card-header">
                                    <Label text="Tu equipo" styleClass="card-title"/>
                                </StackPane>
                                <StackPane styleClass="empty-card-body" VBox.vgrow="ALWAYS">
                                    <Label text="Sin equipo" styleClass="body-muted"/>
                                </StackPane>
                            </VBox>
                        </FlowPane>
                    </VBox>
                </content>
            </ScrollPane>

            <ScrollPane fx:id="liveView" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
                <content>
                    <VBox spacing="20.0" styleClass="content, live-content">
                        <padding><Insets bottom="44.0" left="36.0" right="36.0" top="28.0"/></padding>

                        <HBox spacing="20.0">
                            <VBox fx:id="battleSummaryCard" prefWidth="440.0" minWidth="0.0" spacing="14.0" onMouseClicked="#openCombatDetails"
                                  styleClass="live-battle-card, clickable-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="CAMPO DE BATALLA" styleClass="live-section-kicker"/>
                                        <Label fx:id="battleModeLabel" text="Fuera de combate" styleClass="live-card-title"/>
                                    </VBox>
                                    <Label text="⚔" styleClass="battle-icon"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" minHeight="176.0" spacing="20.0" styleClass="battle-summary-body">
                                    <VBox alignment="CENTER" spacing="5.0" styleClass="battle-enemy-preview">
                                        <ImageView fx:id="enemyActiveSprite" fitHeight="94.0" fitWidth="110.0" preserveRatio="true" smooth="false"/>
                                        <Label fx:id="enemyActiveLabel" text="—" styleClass="battle-enemy-name"/>
                                    </VBox>
                                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                        <Label fx:id="battleSummaryMessage" text="Esperando un combate" wrapText="true" styleClass="battle-summary-message"/>
                                        <Label fx:id="battleSummaryLink" text="ABRIR DETALLE  →" wrapText="true" styleClass="battle-summary-link"/>
                                    </VBox>
                                </HBox>
                                <VBox managed="false" visible="false">
                                    <ImageView fx:id="playerActiveSprite"/>
                                    <Label fx:id="playerActiveLabel"/>
                                    <Label fx:id="playerActiveMetaLabel"/><Label fx:id="enemyActiveMetaLabel"/>
                                    <ProgressBar fx:id="playerHpBar"/><ProgressBar fx:id="enemyHpBar"/>
                                    <Label fx:id="playerHpLabel"/><Label fx:id="enemyHpLabel"/>
                                    <Label fx:id="playerBattleDetailsLabel"/><Label fx:id="enemyBattleDetailsLabel"/>
                                    <Label fx:id="playerMove0Label"/><Label fx:id="playerMove1Label"/>
                                    <Label fx:id="playerMove2Label"/><Label fx:id="playerMove3Label"/>
                                </VBox>
                            </VBox>

                            <VBox prefWidth="310.0" spacing="12.0" styleClass="live-log-card">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="REGISTRO" styleClass="live-section-kicker" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="combatLogModeChip" text="HISTORIAL" styleClass="live-mini-chip"/>
                                </HBox>
                                <Label fx:id="combatLogLabel" text="No hay combates guardados"
                                       wrapText="true" styleClass="live-muted"/>
                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="150"
                                            VBox.vgrow="ALWAYS" styleClass="battle-log-list-scroll">
                                    <content><VBox fx:id="combatLogEntries" spacing="7"/></content>
                                </ScrollPane>
                            </VBox>
                        </HBox>

                        <VBox spacing="14.0" styleClass="live-team-card">
                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label text="TU EQUIPO" styleClass="live-section-kicker"/>
                                    <Label text="Pokémon Sun / Moon · 6 slots" styleClass="live-card-title"/>
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" spacing="4.0">
                                    <Button fx:id="pokeVialButton" onAction="#usePokeVial"
                                            text="POKE VIAL  ·  3/3" styleClass="poke-vial-button"/>
                                    <Label fx:id="pokeVialStatus" text="Restaura PS, estado y PP"
                                           styleClass="poke-vial-status"/>
                                </VBox>
                                <Label fx:id="teamSummaryLabel" text="Leyendo equipo…" styleClass="team-summary"/>
                            </HBox>

                            <GridPane hgap="12.0" vgap="12.0">
                                <HBox fx:id="partySlot0Card" userData="0" onMouseClicked="#openPokemonDetails" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="pokemon-slot">
                                    <Label text="01" styleClass="slot-number"/>
                                    <ImageView fx:id="partySlot0Sprite" fitHeight="60.0" fitWidth="60.0" preserveRatio="true" smooth="false" styleClass="slot-sprite"/>
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label fx:id="partySlot0Name" text="Vacío" styleClass="slot-name"/>
                                        <Label fx:id="partySlot0Details" text="—" styleClass="slot-details"/>
                                    </VBox>
                                    <Label fx:id="partySlot0Hp" text="" styleClass="slot-hp"/>
                                </HBox>
                                <HBox fx:id="partySlot1Card" userData="1" onMouseClicked="#openPokemonDetails" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="pokemon-slot">
                                    <Label text="02" styleClass="slot-number"/>
                                    <ImageView fx:id="partySlot1Sprite" fitHeight="60.0" fitWidth="60.0" preserveRatio="true" smooth="false" styleClass="slot-sprite"/>
                                    <VBox HBox.hgrow="ALWAYS"><Label fx:id="partySlot1Name" text="Vacío" styleClass="slot-name"/><Label fx:id="partySlot1Details" text="—" styleClass="slot-details"/></VBox>
                                    <Label fx:id="partySlot1Hp" text="" styleClass="slot-hp"/>
                                </HBox>
                                <HBox fx:id="partySlot2Card" userData="2" onMouseClicked="#openPokemonDetails" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="pokemon-slot">
                                    <Label text="03" styleClass="slot-number"/>
                                    <ImageView fx:id="partySlot2Sprite" fitHeight="60.0" fitWidth="60.0" preserveRatio="true" smooth="false" styleClass="slot-sprite"/>
                                    <VBox HBox.hgrow="ALWAYS"><Label fx:id="partySlot2Name" text="Vacío" styleClass="slot-name"/><Label fx:id="partySlot2Details" text="—" styleClass="slot-details"/></VBox>
                                    <Label fx:id="partySlot2Hp" text="" styleClass="slot-hp"/>
                                </HBox>
                                <HBox fx:id="partySlot3Card" userData="3" onMouseClicked="#openPokemonDetails" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="pokemon-slot">
                                    <Label text="04" styleClass="slot-number"/>
                                    <ImageView fx:id="partySlot3Sprite" fitHeight="60.0" fitWidth="60.0" preserveRatio="true" smooth="false" styleClass="slot-sprite"/>
                                    <VBox HBox.hgrow="ALWAYS"><Label fx:id="partySlot3Name" text="Vacío" styleClass="slot-name"/><Label fx:id="partySlot3Details" text="—" styleClass="slot-details"/></VBox>
                                    <Label fx:id="partySlot3Hp" text="" styleClass="slot-hp"/>
                                </HBox>
                                <HBox fx:id="partySlot4Card" userData="4" onMouseClicked="#openPokemonDetails" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="pokemon-slot">
                                    <Label text="05" styleClass="slot-number"/>
                                    <ImageView fx:id="partySlot4Sprite" fitHeight="60.0" fitWidth="60.0" preserveRatio="true" smooth="false" styleClass="slot-sprite"/>
                                    <VBox HBox.hgrow="ALWAYS"><Label fx:id="partySlot4Name" text="Vacío" styleClass="slot-name"/><Label fx:id="partySlot4Details" text="—" styleClass="slot-details"/></VBox>
                                    <Label fx:id="partySlot4Hp" text="" styleClass="slot-hp"/>
                                </HBox>
                                <HBox fx:id="partySlot5Card" userData="5" onMouseClicked="#openPokemonDetails" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="pokemon-slot">
                                    <Label text="06" styleClass="slot-number"/>
                                    <ImageView fx:id="partySlot5Sprite" fitHeight="60.0" fitWidth="60.0" preserveRatio="true" smooth="false" styleClass="slot-sprite"/>
                                    <VBox HBox.hgrow="ALWAYS"><Label fx:id="partySlot5Name" text="Vacío" styleClass="slot-name"/><Label fx:id="partySlot5Details" text="—" styleClass="slot-details"/></VBox>
                                    <Label fx:id="partySlot5Hp" text="" styleClass="slot-hp"/>
                                </HBox>
                            </GridPane>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>

            <fx:include fx:id="boxesView" source="boxes-view.fxml" managed="false" visible="false"/>
            <fx:include fx:id="wildcardsView" source="wildcards-view.fxml" managed="false" visible="false"/>
            <fx:include fx:id="inventoryView" source="inventory-view.fxml" managed="false" visible="false"/>
            <fx:include fx:id="mailboxView" source="mailbox-view.fxml" managed="false" visible="false"/>
            <fx:include fx:id="boosterPacksView" source="booster-packs-view.fxml" managed="false" visible="false"/>
            <fx:include fx:id="profileView" source="profile-view.fxml" managed="false" visible="false"/>

            <fx:include fx:id="combatDetailView" source="single-combat-panel.fxml" managed="false" visible="false"/>
            <fx:include fx:id="doubleCombatDetailView" source="double-combat-panel.fxml" managed="false" visible="false"/>
            <fx:include fx:id="sosCombatDetailView" source="sos-combat-panel.fxml" managed="false" visible="false"/>
            <fx:include fx:id="battleRoyaleCombatDetailView" source="battle-royale-combat-panel.fxml" managed="false" visible="false"/>
            <fx:include fx:id="allyCombatDetailView" source="ally-combat-panel.fxml" managed="false" visible="false"/>
            <fx:include fx:id="pokemonDetail" source="pokemon-detail-view.fxml"/>
            <fx:include fx:id="battleLog" source="battle-log-view.fxml"/>
        </StackPane>
    </center>
</BorderPane>
