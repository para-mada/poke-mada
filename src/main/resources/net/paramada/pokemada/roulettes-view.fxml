<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <content>
        <HBox alignment="CENTER" spacing="24" styleClass="roulette-page">
            <padding><Insets bottom="40" left="34" right="34" top="34"/></padding>
            <VBox prefWidth="215" spacing="14" styleClass="roulette-selector">
                <Label text="BANNERS" styleClass="roulette-selector-title"/>
                <Button disable="true" maxWidth="Infinity" text="RULETA INICIAL" styleClass="roulette-banner active-banner"/>
                <Button disable="true" maxWidth="Infinity" text="SEGUNDO GIMNASIO" styleClass="roulette-banner"/>
                <Button disable="true" maxWidth="Infinity" text="COMODINES" styleClass="roulette-banner"/>
            </VBox>
            <VBox maxWidth="720" spacing="16" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="TIROS DISPONIBLES" styleClass="roulette-counter-label"/>
                    <Label text="0" styleClass="roulette-counter"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <StackPane minHeight="410" styleClass="roulette-hero">
                    <VBox alignment="CENTER" spacing="16">
                        <Label text="RULETA" styleClass="roulette-hero-title"/>
                        <Label text="Selecciona un banner para consultar sus recompensas" styleClass="roulette-hero-copy"/>
                        <Button disable="true" text="TIRAR  ✦" styleClass="roulette-spin-button"/>
                    </VBox>
                </StackPane>
                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Button disable="true" text="LISTA DE RECOMPENSAS  ›" styleClass="roulette-secondary-button"/>
                    <Button disable="true" text="HISTORIAL  ›" styleClass="roulette-secondary-button"/>
                </HBox>
            </VBox>
        </HBox>
    </content>
</ScrollPane>
