<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="net.paramada.pokemada.BoxesController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="14" styleClass="boxes-content">
            <padding><Insets bottom="42" left="38" right="38" top="32"/></padding>

            <VBox maxWidth="900" spacing="0" styleClass="boxes-card">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="boxes-toolbar">
                    <Button mnemonicParsing="false" onAction="#previousBox" text="‹" styleClass="box-arrow"/>
                    <VBox spacing="1">
                        <Label fx:id="boxName" text="CAJA 1" styleClass="box-name"/>
                        <Label text="ALMACENAMIENTO DEL PC" styleClass="box-kicker"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="occupancy" text="0 / 30" styleClass="box-occupancy"/>
                    <Button mnemonicParsing="false" onAction="#nextBox" text="›" styleClass="box-arrow"/>
                </HBox>

                <VBox spacing="18" styleClass="boxes-body">
                    <GridPane fx:id="boxGrid" alignment="CENTER" hgap="12" vgap="12"/>
                    <HBox alignment="CENTER_LEFT" spacing="9" styleClass="box-data-status">
                        <Label text="●" styleClass="box-status-dot"/>
                        <Label fx:id="dataStatus" text="Selecciona o carga un guardado" styleClass="box-status-text"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
