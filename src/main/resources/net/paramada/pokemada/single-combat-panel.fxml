<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll" fx:id="singleCombatPanel"
            fx:controller="net.paramada.pokemada.SingleCombatPanelController">
    <content>
        <VBox spacing="20.0" styleClass="content, combat-detail-content">
            <padding><Insets bottom="44.0" left="36.0" right="36.0" top="28.0"/></padding>
            <HBox alignment="CENTER_LEFT"><Button text="‹ VOLVER A LIVE" onAction="#closeCombatDetails" styleClass="detail-back-button"/></HBox>
            <GridPane hgap="24.0" vgap="24.0" styleClass="combat-dashboard">
                <VBox prefWidth="570.0" spacing="0" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="combat-pokemon-detail">
                    <StackPane maxWidth="Infinity" styleClass="detail-team-header, enemy-header"><Label text="Pokémon Enemigo" styleClass="detail-header-title"/></StackPane>
                    <HBox alignment="CENTER" spacing="16.0" styleClass="detail-card-body, compact-fighter-body">
                        <HBox alignment="CENTER_LEFT" prefWidth="240.0" spacing="10.0" styleClass="fighter-identity-card, enemy-identity">
                            <VBox alignment="CENTER" spacing="4.0"><ImageView fx:id="detailEnemySprite" fitHeight="100.0" fitWidth="112.0" preserveRatio="true" smooth="false"/><HBox alignment="CENTER" spacing="5.0"><ImageView fx:id="detailEnemyTypeOne" fitHeight="34.0" fitWidth="34.0" preserveRatio="true"/><ImageView fx:id="detailEnemyTypeTwo" fitHeight="34.0" fitWidth="34.0" preserveRatio="true"/></HBox></VBox>
                            <VBox alignment="CENTER_LEFT" spacing="7.0" HBox.hgrow="ALWAYS"><Label fx:id="detailEnemyName" text="—" wrapText="true" styleClass="detail-pokemon-name"/><Label fx:id="detailEnemyMeta" wrapText="true" styleClass="detail-pokemon-meta"/><Label fx:id="detailEnemyStatus" managed="false" visible="false" styleClass="status-badge"/><Label fx:id="detailEnemyAbility" wrapText="true" maxWidth="125" styleClass="detail-data-chip"/><Label fx:id="detailEnemyItem" wrapText="true" maxWidth="125" styleClass="detail-data-chip"/></VBox>
                        </HBox>
                        <VBox prefWidth="230.0" spacing="7.0">
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailEnemyStat0Label" text="Ataque" styleClass="stat-label"/><ProgressBar fx:id="detailEnemyStat0" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailEnemyBoost0" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailEnemyStat1Label" text="Defensa" styleClass="stat-label"/><ProgressBar fx:id="detailEnemyStat1" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailEnemyBoost1" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailEnemyStat2Label" text="At. Esp." styleClass="stat-label"/><ProgressBar fx:id="detailEnemyStat2" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailEnemyBoost2" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailEnemyStat3Label" text="Def. Esp." styleClass="stat-label"/><ProgressBar fx:id="detailEnemyStat3" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailEnemyBoost3" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailEnemyStat4Label" text="Velocidad" styleClass="stat-label"/><ProgressBar fx:id="detailEnemyStat4" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailEnemyBoost4" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <Label fx:id="detailEnemyInfo" managed="false" visible="false"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox prefWidth="330.0" spacing="0" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="combat-team-card">
                    <StackPane maxWidth="Infinity" styleClass="detail-team-header, enemy-header"><Label text="Equipo Enemigo" styleClass="detail-header-title"/></StackPane>
                    <FlowPane alignment="CENTER" hgap="18.0" vgap="10.0" prefWrapLength="270.0" styleClass="detail-roster"><ImageView fx:id="detailEnemyTeam0" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailEnemyTeam1" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailEnemyTeam2" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailEnemyTeam3" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailEnemyTeam4" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailEnemyTeam5" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/></FlowPane>
                </VBox>
                <VBox prefWidth="570.0" spacing="0" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="combat-pokemon-detail">
                    <StackPane maxWidth="Infinity" styleClass="detail-team-header, player-header"><Label text="Tu Pokémon" styleClass="detail-header-title"/></StackPane>
                    <HBox alignment="CENTER" spacing="16.0" styleClass="detail-card-body, compact-fighter-body">
                        <HBox alignment="CENTER_LEFT" prefWidth="240.0" spacing="10.0" styleClass="fighter-identity-card, player-identity">
                            <VBox alignment="CENTER" spacing="4.0"><ImageView fx:id="detailPlayerSprite" fitHeight="100.0" fitWidth="112.0" preserveRatio="true" smooth="false"/><HBox alignment="CENTER" spacing="5.0"><ImageView fx:id="detailPlayerTypeOne" fitHeight="34.0" fitWidth="34.0" preserveRatio="true"/><ImageView fx:id="detailPlayerTypeTwo" fitHeight="34.0" fitWidth="34.0" preserveRatio="true"/></HBox></VBox>
                            <VBox alignment="CENTER_LEFT" spacing="7.0" HBox.hgrow="ALWAYS"><Label fx:id="detailPlayerName" text="—" wrapText="true" styleClass="detail-pokemon-name"/><Label fx:id="detailPlayerMeta" wrapText="true" styleClass="detail-pokemon-meta"/><Label fx:id="detailPlayerStatus" managed="false" visible="false" styleClass="status-badge"/><Label fx:id="detailPlayerAbility" wrapText="true" maxWidth="125" styleClass="detail-data-chip"/><Label fx:id="detailPlayerItem" wrapText="true" maxWidth="125" styleClass="detail-data-chip"/></VBox>
                        </HBox>
                        <VBox prefWidth="230.0" spacing="7.0">
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailPlayerStat0Label" text="Ataque" styleClass="stat-label"/><ProgressBar fx:id="detailPlayerStat0" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailPlayerBoost0" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailPlayerStat1Label" text="Defensa" styleClass="stat-label"/><ProgressBar fx:id="detailPlayerStat1" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailPlayerBoost1" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailPlayerStat2Label" text="At. Esp." styleClass="stat-label"/><ProgressBar fx:id="detailPlayerStat2" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailPlayerBoost2" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailPlayerStat3Label" text="Def. Esp." styleClass="stat-label"/><ProgressBar fx:id="detailPlayerStat3" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailPlayerBoost3" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label fx:id="detailPlayerStat4Label" text="Velocidad" styleClass="stat-label"/><ProgressBar fx:id="detailPlayerStat4" progress="0" HBox.hgrow="ALWAYS"/><Label fx:id="detailPlayerBoost4" managed="false" visible="false" styleClass="stat-boost-badge"/></HBox>
                            <Label fx:id="detailPlayerInfo" managed="false" visible="false"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="10.0" styleClass="detail-moves-area"><Label text="MOVIMIENTOS" styleClass="detail-section-title"/><GridPane hgap="12.0" vgap="10.0"><HBox fx:id="detailMove0" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="detail-move-card"/><HBox fx:id="detailMove1" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="detail-move-card"/><HBox fx:id="detailMove2" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="detail-move-card"/><HBox fx:id="detailMove3" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="detail-move-card"/></GridPane></VBox>
                </VBox>
                <VBox spacing="24.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <VBox prefWidth="330.0" spacing="0" styleClass="combat-team-card"><StackPane maxWidth="Infinity" styleClass="detail-team-header, player-header"><Label text="Tu Equipo" styleClass="detail-header-title"/></StackPane><FlowPane alignment="CENTER" hgap="18.0" vgap="10.0" prefWrapLength="270.0" styleClass="detail-roster">
                        <StackPane fx:id="detailPlayerTeamCard0" userData="0" onMouseClicked="#openPokemonDetails" styleClass="team-pokemon-preview"><ImageView fx:id="detailPlayerTeam0" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailPlayerItem0" fitHeight="20" fitWidth="20" managed="false" visible="false" preserveRatio="true" StackPane.alignment="BOTTOM_RIGHT" styleClass="team-item-badge"/></StackPane>
                        <StackPane fx:id="detailPlayerTeamCard1" userData="1" onMouseClicked="#openPokemonDetails" styleClass="team-pokemon-preview"><ImageView fx:id="detailPlayerTeam1" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailPlayerItem1" fitHeight="20" fitWidth="20" managed="false" visible="false" preserveRatio="true" StackPane.alignment="BOTTOM_RIGHT" styleClass="team-item-badge"/></StackPane>
                        <StackPane fx:id="detailPlayerTeamCard2" userData="2" onMouseClicked="#openPokemonDetails" styleClass="team-pokemon-preview"><ImageView fx:id="detailPlayerTeam2" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailPlayerItem2" fitHeight="20" fitWidth="20" managed="false" visible="false" preserveRatio="true" StackPane.alignment="BOTTOM_RIGHT" styleClass="team-item-badge"/></StackPane>
                        <StackPane fx:id="detailPlayerTeamCard3" userData="3" onMouseClicked="#openPokemonDetails" styleClass="team-pokemon-preview"><ImageView fx:id="detailPlayerTeam3" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailPlayerItem3" fitHeight="20" fitWidth="20" managed="false" visible="false" preserveRatio="true" StackPane.alignment="BOTTOM_RIGHT" styleClass="team-item-badge"/></StackPane>
                        <StackPane fx:id="detailPlayerTeamCard4" userData="4" onMouseClicked="#openPokemonDetails" styleClass="team-pokemon-preview"><ImageView fx:id="detailPlayerTeam4" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailPlayerItem4" fitHeight="20" fitWidth="20" managed="false" visible="false" preserveRatio="true" StackPane.alignment="BOTTOM_RIGHT" styleClass="team-item-badge"/></StackPane>
                        <StackPane fx:id="detailPlayerTeamCard5" userData="5" onMouseClicked="#openPokemonDetails" styleClass="team-pokemon-preview"><ImageView fx:id="detailPlayerTeam5" fitHeight="68.0" fitWidth="76.0" preserveRatio="true" smooth="false"/><ImageView fx:id="detailPlayerItem5" fitHeight="20" fitWidth="20" managed="false" visible="false" preserveRatio="true" StackPane.alignment="BOTTOM_RIGHT" styleClass="team-item-badge"/></StackPane>
                    </FlowPane></VBox>
                    <Button text="L O G  D E  B A T A L L A   ⚔" maxWidth="Infinity" onAction="#openCurrentBattleLog" styleClass="battle-log-button"/>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
